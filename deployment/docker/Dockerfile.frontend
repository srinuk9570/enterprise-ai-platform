# Frontend Dockerfile for Streamlit application
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements/prod.txt requirements.txt
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash aiplatform

# Copy Python packages from builder
COPY --from=builder /root/.local /home/aiplatform/.local
ENV PATH=/home/aiplatform/.local/bin:$PATH

# Copy application code
COPY --chown=aiplatform:aiplatform src/ ./src/
COPY --chown=aiplatform:aiplatform src/presentation/web/assets ./assets

# Switch to non-root user
USER aiplatform

# Streamlit configuration
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Expose port
EXPOSE 8501

# Run application
CMD ["streamlit", "run", "src/presentation/web/Home.py"]