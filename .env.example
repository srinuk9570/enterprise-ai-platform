# ============================================
# Enterprise AI Platform - Environment Configuration
# ============================================
# Copy this file to .env and update with your values

# ==================== Application ====================
APP_NAME="Enterprise AI Platform"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-secret-key-in-production-please-use-a-strong-random-string
ENVIRONMENT=development

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# ==================== Database ====================
DATABASE_URL=sqlite:///./data/database/app.db
DATABASE_PATH=./data/database/app.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ==================== Vector Store ====================
VECTOR_STORE_PATH=./data/vector_store

# ==================== Redis Cache ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Ollama LLM ====================
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=300
DEFAULT_MODEL=deepseek-r1:1.5b
FALLBACK_MODEL=llama3.2:3b
IMAGE_MODEL=x/z-image-turbo
EMBEDDING_MODEL=nomic-embed-text

# ==================== Security ====================
JWT_SECRET_KEY=change-this-jwt-secret-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# API Key settings
API_KEY_PREFIX=eap_
API_KEY_LENGTH=32

# ==================== Rate Limiting ====================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_BLOCK_DURATION=300

# ==================== File Upload ====================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_PATH=./data/uploads
GENERATED_IMAGES_PATH=./data/generated/images
GENERATED_CHARTS_PATH=./data/generated/charts

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE_PATH=./data/logs/app.log
LOG_JSON_ENABLED=true
LOG_RETENTION_DAYS=30

# ==================== Email (Optional) ====================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@enterprise-ai.local
SMTP_USE_TLS=true

# ==================== Features ====================
FEATURE_IMAGE_GENERATION=true
FEATURE_CHART_GENERATION=true
FEATURE_RAG=true
FEATURE_STREAMING=true
FEATURE_WEBSOCKET=true
FEATURE_API_KEYS=true
